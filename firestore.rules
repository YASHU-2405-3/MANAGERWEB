rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function isParticipant(conversationId) {
      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
    }
    match /users/{userId} {
      allow create: if signedIn() && request.auth.uid == userId && request.resource.data.role in ['creator', 'brand'];
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow update: if signedIn() && request.auth.uid == userId && request.resource.data.role == resource.data.role;
      allow delete: if isAdmin();
    }
    function isCreatorAccount() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'creator';
    }
    match /creatorProfiles/{profileId} {
      allow read: if isAdmin()
        || (resource.data.status == 'verified' && resource.data.isPublic == true)
        || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if isAdmin()
        || (isCreatorAccount()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.status == 'pending'
          && request.resource.data.isPublic == false
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.profileUrl is string
          && request.resource.data.profileUrl.matches('https://.*')
          && request.resource.data.category is string
          && request.resource.data.createdAt == request.time);
      allow update: if isAdmin()
        || (isCreatorAccount()
          && resource.data.uid == request.auth.uid
          && resource.data.status == 'pending'
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.status == 'pending'
          && request.resource.data.isPublic == false
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name','email','category','platform','city','profileUrl','socialLinks',
            'bio','followers','updatedAt','reviewRequestedAt'
          ]));
      allow delete: if isAdmin();
    }

    match /contactMessages/{messageId} {
      allow create: if request.resource.data.keys().hasOnly([
          'name','email','type','message','status','createdAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.size() > 3
        && request.resource.data.email.size() <= 180
        && request.resource.data.type in ['creator','brand','other']
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 10
        && request.resource.data.message.size() <= 3000
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if isAdmin();
    }

  }
}