rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function isParticipant(conversationId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
    }

    match /users/{userId} {
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.role in ['creator', 'brand'];

      allow read: if signedIn()
        && (request.auth.uid == userId || isAdmin());

      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.role == resource.data.role;

      allow delete: if isAdmin();
    }

    match /applications/{applicationId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.type in ['creator', 'brand']
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;

      allow read: if signedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());

      allow update, delete: if isAdmin();
    }

    match /conversations/{conversationId} {
      // Users may open their own support conversation. Application conversations remain admin-created on approval.
      allow create: if isAdmin()
        || (signedIn()
          && request.resource.data.keys().hasOnly([
            'type','source','status','userId','customerName','customerEmail','customerRole',
            'participantIds','participantNames','participantEmails','lastMessage','createdAt','updatedAt'
          ])
          && request.resource.data.source == 'support'
          && request.resource.data.status == 'open'
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.type in ['creator', 'brand']
          && request.resource.data.customerRole in ['creator', 'brand']
          && request.resource.data.customerEmail == request.auth.token.email
          && request.resource.data.participantIds == [request.auth.uid]
          && request.resource.data.participantNames == [request.resource.data.customerName]
          && request.resource.data.participantEmails == [request.auth.token.email]
          && request.resource.data.lastMessage == ''
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time);

      allow read: if signedIn()
        && (request.auth.uid in resource.data.participantIds || isAdmin());

      allow update: if isAdmin()
        || (signedIn()
          && request.auth.uid in resource.data.participantIds
          && ((resource.data.source == 'support' && resource.data.status == 'open')
            || (resource.data.source == 'application' && resource.data.status == 'approved'))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'lastMessage','updatedAt','customerName','customerEmail','customerRole'
          ])
          && request.resource.data.participantIds == resource.data.participantIds
          && request.resource.data.status == resource.data.status
          && request.resource.data.source == resource.data.source
          && request.resource.data.userId == resource.data.userId);

      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow create: if isAdmin()
          || (signedIn()
            && request.auth.uid == request.resource.data.senderId
            && isParticipant(conversationId)
            && ((get(/databases/$(database)/documents/conversations/$(conversationId)).data.source == 'support'
                && get(/databases/$(database)/documents/conversations/$(conversationId)).data.status == 'open')
              || (get(/databases/$(database)/documents/conversations/$(conversationId)).data.source == 'application'
                && get(/databases/$(database)/documents/conversations/$(conversationId)).data.status == 'approved'))
            && request.resource.data.keys().hasOnly([
              'text','senderId','senderName','senderEmail','senderRole','createdAt'
            ])
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 2000
            && request.resource.data.createdAt == request.time);

        allow read: if isAdmin() || isParticipant(conversationId);
        allow update, delete: if isAdmin();
      }
    }
  }
}
